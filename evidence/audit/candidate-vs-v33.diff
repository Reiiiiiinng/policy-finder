+  .followup .plan-hero h1 { font-size: 23px; }
+  .followup .plan-hero-copy { max-width: 155px; font-size: 13px; }
+  .plan-family-art { width: 149px; right: -5px; }
+  .plan-body { padding-inline: 12px; }
+  .plan-overview .plan-next { padding: 17px; border-radius: 21px; }
+  .followup .plan-next h3 { font-size: 19px; }
+  .plan-next-actions { gap: 10px; }
+  .plan-channel-link { font-size: 12px; }
