+.plan-progress progress::-webkit-progress-bar { background: #e8eddf; border-radius: 6px; }
+.plan-progress progress::-webkit-progress-value { background: #3d8056; border-radius: 6px; }
+.plan-progress progress::-moz-progress-bar { background: #3d8056; }
+.followup .plan-progress p { display: flex; flex-wrap: wrap; gap: 4px 12px; justify-content: space-between; margin: 0; color: #4e6f51; font-size: 11px; }
+.plan-progress p span { color: #68756c; }
+.plan-overview .plan-next {
+  margin: 9px 0 0;
+  padding: 20px;
+  border: 1px solid #dfe8d9;
+  border-radius: 24px;
+  background: #fffefa;
