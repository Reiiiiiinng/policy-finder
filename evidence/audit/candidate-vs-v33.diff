+.followup .plan-green-note { margin: 12px 0 0; padding-top: 12px; border-top: 1px solid #e7ebdf; font-size: 12px; line-height: 1.75; color: #64805b; }
+.plan-rights { padding: 8px 3px 0; }
+.plan-rights-list { margin-top: 8px; }
+.plan-rights .fu-entry { grid-template-columns: 24px minmax(0,1fr) auto; gap: 8px; min-height: 86px; padding: 14px 0; border-color: #e5eadd; }
+.plan-rights .fu-entry[aria-current=true] { background: transparent; border-radius: 0; }
+.plan-right-number { align-self: start; padding-top: 3px; color: #91a084; font-size: 12px; font-weight: 650; }
+.plan-right-name { color: #254a32; font-size: 14px; font-weight: 650; line-height: 1.7; }
+.plan-right-name small { display: block; margin-top: 3px; color: #68756c; font-size: 11px; font-weight: 400; }
+.plan-overview > .plan-body > .fu-disclosure { margin: 12px 0 0; padding: 2px 16px; border-radius: 17px; background: #f6f7ee; border-color: #e5e9dc; }
+.plan-overview > .plan-body > .fu-disclosure > summary { display: list-item; padding: 13px 0; color: #4e6f4a; font-size: 13px; font-weight: 600; }
+.plan-overview .fu-disclosure .fu-row { gap: 7px; }
+.plan-overview .fu-disclosure .fu-button { border-radius: 12px; min-height: 44px; font-size: 13px; }
+.plan-overview .fu-disclosure p, .plan-overview .fu-disclosure li { font-size: 13px; }
+.plan-pause-controls { padding-top: 12px; border-top: 1px solid #e2e7da; margin: 16px 0; }
+.followup .plan-pause-controls h3 { font-size: 14px; }
+.followup .plan-pause-controls p, .followup .plan-pause-controls label { font-size: 12px; color: #6b7862; }
+.plan-overview .plan-state-note { margin: 12px 0; padding: 16px; border: 1px solid #e8ddbd; border-radius: 16px; background: #fbf3df; font-size: 13px; }
+.plan-state-note .fu-button { min-height: 44px; }
+.followup .plan-state-note h2 { font-size: 16px; }
+.followup .plan-footnote { margin: 22px 8px 5px; color: #68756c; font-size: 11px; text-align: center; line-height: 1.85; }
+@media (max-width: 350px) {
