+  right: -5px;
+  bottom: 39px;
+  width: 180px;
+  height: auto;
+}
+.plan-family-line {
+  position: absolute;
+  inset: auto 16px 12px;
+  z-index: 1;
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 4px 12px;
+  min-height: 38px;
+  padding: 8px 12px;
+  border: 1px solid #e4e9da;
+  border-radius: 12px;
+  background: #fffefa;
+  color: #48624b;
+  font-size: 12px;
+  line-height: 1.5;
+}
+.plan-family-line strong { font-weight: 700; color: #1d4f33; }
+.plan-region { white-space: nowrap; color: #64735d; }
+.plan-body { padding: 0 16px 20px; }
+.plan-progress { padding: 17px 3px 8px; }
+.plan-progress > div { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; font-size: 12px; color: #62725e; }
+.plan-progress strong { font-size: 17px; font-weight: 700; color: #275d39; }
