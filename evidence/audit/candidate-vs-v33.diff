+.followup .plan-section-heading h2 { margin: 0; font-size: 14px; font-weight: 700; color: #406b49; }
+.plan-section-heading > span:not(.fu-badge) { color: #64715c; font-size: 11px; white-space: nowrap; }
+.plan-overview .fu-badge { padding: 3px 8px; font-size: 11px; line-height: 1.6; }
+.followup .plan-next h3 { margin: 12px 0 8px; color: #193f2b; font-size: 21px; line-height: 1.55; font-weight: 750; }
