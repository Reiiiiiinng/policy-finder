+.plan-route { padding: 22px 3px 16px; }
+.plan-route-steps { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 6px; margin-top: 13px; }
+.plan-route-steps a { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 10px 2px; border: 1px solid transparent; border-radius: 13px; color: #697760; text-decoration: none; text-align: center; }
+.plan-step-number { display: grid; place-items: center; min-height: 30px; margin-bottom: 3px; font-size: 18px; font-weight: 650; font-variant-numeric: tabular-nums; color: #8d9a82; }
+.plan-route-steps strong { font-size: 12px; font-weight: 650; line-height: 1.6; white-space: nowrap; }
+.plan-route-steps small { margin-top: 3px; font-size: 11px; line-height: 1.5; color: #65715d; }
+.plan-route-steps [aria-current] { border-color: #d3e3ca; background: #eaf2e1; color: #245f3d; }
