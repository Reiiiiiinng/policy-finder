+  --ink: #193f2b;
+  --text: #193f2b;
+  --ink-2: #3e5143;
+  --muted: #63715e;
+  --line: #e5e9dd;
+  --paper: #fffefa;
+  --surface: #fdfaf5;
+  --soft: #edf3e5;
+  --trust: #f2f5eb;
+  --trust-ink: #406b49;
+  --trust-line: #dde6d5;
+  --warn: #805b25;
+  --warn-soft: #fbf3df;
+  --warn-line: #e9dfc5;
+  max-width: none;
+  margin: 0;
+  padding: 0;
+  background: #fdfaf5;
+  color: var(--ink);
+  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
+  line-height: 1.75;
+}
+
+.policy-detail .app {
+  width: 100%;
+  max-width: 480px;
+  margin: 0 auto;
+  background: var(--surface);
+  box-shadow: none;
+}
+.policy-detail.v32-flow.has-global-nav { padding-bottom: 0; }
+.policy-detail .topbar {
+  position: relative;
+  min-height: 56px;
+  padding: calc(6px + env(safe-area-inset-top)) 20px 6px;
+  border: 0;
+  border-bottom: 1px solid #e9ecdf;
+  background: linear-gradient(180deg, #ffffff 0%, #f8fbf9 55%, #f2f8f5 100%);
+}
+.policy-detail .topbar .detail-topbar-row {
+  display: grid;
+  grid-template-columns: 70px minmax(0, 1fr) 70px;
+  align-items: center;
+  gap: 8px;
+}
+.policy-detail .detail-topbar-title { color: #245f3d; font-size: 16px; font-weight: 700; text-align: center; }
+.policy-detail .topbar .back-link {
+  display: inline-flex;
+  flex: none;
+  align-items: center;
+  min-height: 44px;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  background: transparent;
+  color: #3e653c;
+  font-size: 14px;
+  font-weight: 500;
