diff --git a/frontend/assets/history-polish.css b/frontend/assets/history-polish.css
new file mode 100644
index 0000000..0927efc
--- /dev/null
+++ b/frontend/assets/history-polish.css
@@ -0,0 +1,60 @@
+/* Query history shares the warm forest-green family service language. */
+.history-page { background: #f8f4eb; }
+.history-app.q-app { padding: 0 18px calc(85px + env(safe-area-inset-bottom)); background: linear-gradient(180deg, #f3f5e8 0%, #fbf7ee 50%, #f8f4eb 100%); color: #25472f; }
+.history-top.q-head { min-height: calc(72px + env(safe-area-inset-top)); margin: 0 -18px; padding: calc(6px + env(safe-area-inset-top)) 19px 18px; gap: 12px; border: 0; background: linear-gradient(125deg, #29734f, #075b38); font-weight: 400; }
+.history-top .q-back { display: inline-flex; align-items: center; width: auto; min-width: 72px; height: 44px; padding: 0; color: #fffef8; font-size: 14px; font-weight: 550; line-height: 1.5; text-decoration: none; }
+.history-intro { position: relative; isolation: isolate; overflow: hidden; margin: -14px -18px 22px; padding: 24px 22px 22px; border: 1px solid #fffdf6; border-radius: 22px 22px 24px 24px; background: radial-gradient(ellipse at 100% 0%, #e1ebd7 0%, transparent 66%), linear-gradient(145deg, #fffdf4, #edf2e3); box-shadow: 0 5px 18px #3f4a2d05; }
+.history-intro::after { content: ""; position: absolute; inset: 0 -18px 0 32%; z-index: 0; background: url("policy-search-skyline.svg") top right / auto 100% no-repeat; opacity: .63; mask-image: linear-gradient(90deg, transparent, black 55%), linear-gradient(black 62%, transparent); mask-composite: intersect; pointer-events: none; }
+.history-intro > * { position: relative; z-index: 1; }
+.history-eyebrow { margin: 0 0 8px; color: #6c785f; font-size: 12px; line-height: 1.7; }
+.history-app .history-intro h1 { margin: 0; color: #214e32; font-size: 28px; font-weight: 750; line-height: 1.45; letter-spacing: -.025em; }
+.history-intro .q-sub { margin: 9px 0 0; color: #66735d; font-size: 14px; line-height: 1.8; }
+.history-status { margin: 0 0 18px; padding: 14px 16px; border: 1px solid #e4e8d9; border-radius: 16px; background: #f4f6ed; color: #627355; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
+.history-status:empty { display: none; }
+.history-status[data-state="error"] { border-color: #eadcc5; background: #faf2e5; color: #7e603b; }
+.history-filter { padding: 18px; border: 1px solid #fffdf8; border-radius: 22px; background: linear-gradient(135deg, #fffef9, #f2f5e8); box-shadow: 0 7px 20px #3f4a2d08; }
+.history-filter .q-label { margin: 0 0 11px; color: #36583a; font-size: 15px; font-weight: 650; line-height: 1.7; }
+.history-app select { min-height: 52px; padding: 12px 14px; border: 1px solid #d4dfc7; border-radius: 13px; background: #fffef8; color: #36583a; font-size: 16px; }
+.history-filter > p { margin: 9px 0 0; color: #858a78; font-size: 12px; line-height: 1.7; }
+.history-results-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 24px 2px 12px; }
+.history-app .history-results-heading h2 { margin: 0; color: #4a6549; font-size: 15px; font-weight: 650; line-height: 1.6; }
+.history-results-heading > span { padding: 3px 9px; border-radius: 10px; background: #e8f0dc; color: #50714a; font-size: 12px; }
+.history-results-heading > span:empty { display: none; }
+.history-app .history-card.q-section { margin: 0 0 14px; padding: 19px 18px 16px; border: 1px solid #dce5d1; border-radius: 23px; background: linear-gradient(145deg, #fffefb, #fffdf7); box-shadow: 0 7px 20px #3149300a; }
+.history-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.history-card h3 { margin: 0; color: #2e5035; font-size: 20px; font-weight: 700; line-height: 1.5; overflow-wrap: anywhere; }
+.history-version { flex: none; display: inline-flex; margin-top: 3px; padding: 3px 8px; border-radius: 8px; background: #e7efda; color: #526b47; font-size: 11px; line-height: 1.65; }
+.history-time { margin: 7px 0 0; color: #78806d; font-size: 13px; line-height: 1.8; }
+.history-snapshot-note { margin: 8px 0 0; color: #8a795c; font-size: 12px; line-height: 1.7; }
+.history-card-actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 17px; padding-top: 15px; border-top: 1px solid #edf0e6; }
+.history-open { display: inline-flex; align-items: center; justify-content: center; min-height: 45px; padding: 10px 23px; border-radius: 24px; background: linear-gradient(130deg, #287d50, #075b38); color: #fff; font-size: 14px; font-weight: 650; line-height: 1.5; text-decoration: none; }
+.history-open:visited { color: #fff; }
+.history-open:hover { background: linear-gradient(130deg, #1c6b43, #06492f); }
+.history-delete.q-clear { flex: none; min-width: 52px; min-height: 44px; padding: 8px 5px; border-radius: 10px; color: #8b7967; font-size: 13px; text-decoration: none; }
+.history-delete.q-clear:hover { background: #f9f0e5; color: #84583f; }
+.history-delete.q-clear:disabled { opacity: .5; cursor: wait; }
