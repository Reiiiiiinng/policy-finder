+/* Plan overview: reuse the home illustration and its forest / cream palette.
+   All rules are scoped to the overview; task forms keep their existing styles. */
+.followup:has(.plan-overview) {
+  --fu-green: #245f3d;
+  --fu-ink: #193f2b;
+  --fu-paper: #fffefa;
