# 运行环境
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 依赖
node_modules/

# 日志与临时产物
*.log
.tools/server.log
.DS_Store
Thumbs.db

# e2e 脚本每次运行都会重写的截图（不是留存证据，别入库）
# 生成处：phase6-e2e.py / phase7-e2e.py / fix-e2e.py / backnav-e2e.py / return-e2e.py
*-run.png

# WorkBuddy 会话数据（不入库）
.workbuddy/
*.genie

# 误落盘的废弃文件
/60

# 设计参考图与对照截图（本地勘察用，不入库）
/_ui/

# 静态站构建产物：build/pages 是 build/build_pages.py 现生成的，
# 内容整份复制进发布仓库，主仓库不再留副本。
# build/engine.js、build/build_pages.py 等源文件仍然入库。
/build/pages/
build/.static_pid
build/expected.json
build/expected_scenes.json
build/_*.png
build/_*.html
build/_*.txt
frontend/_*.html

# 临时截图与验证壳，不入库
_shots/
frontend/_s_*.html
frontend/_frame_*.html
frontend/_tabprobe.html
